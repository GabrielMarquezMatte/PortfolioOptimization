<Project Sdk="Microsoft.NET.Sdk">
  <!-- A clean consumer of the PortOpt package, outside PortOpt.slnx: csharp/scripts/check_package.sh restores it from a
       local package folder, runs it without PORTOPT_LIB and publishes it with Native AOT. Warnings are errors
       (Directory.Build.props), so a trimming or AOT warning fails the check. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PortOptVersion Condition="'$(PortOptVersion)' == ''">0.0.0-unset</PortOptVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PortOpt" Version="$(PortOptVersion)" />
  </ItemGroup>
</Project>
